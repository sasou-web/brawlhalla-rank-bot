node_modules/

# Secrets — ne JAMAIS versionner
.env
backup.env

# Donnees du bot : tout est exclu par defaut (logique inversee).
# Avant, chaque fichier etait liste un par un (data/links.json, data/levels.json...) :
# un nouveau fichier de donnees n'etait donc PAS ignore et pouvait etre commite par
# accident. Depuis la migration vers SQLite, tout vit dans data/bot.db de toute facon.
data/*
# ...sauf le dataset de combos (donnees publiques scrapees, versionnees a dessein pour
# que /combos fonctionne des le premier deploiement).
!data/combos.json

# Sauvegardes
backups/
data_backup_*/

*.log
